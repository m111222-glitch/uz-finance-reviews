# Copy to .env and adjust before sharing.

# Leave empty for open share (no login) — good for colleagues.
# Set a value only if you want a password gate.
DASHBOARD_PASSWORD=

# Extra secret mixed into session cookie (only used if password is set)
DASHBOARD_SECRET=replace-with-random-string

# Shared viewers cannot trigger store sync (recommended when open)
DASHBOARD_READONLY=1

# Optional: force Secure cookies (auto-detected from HTTPS by default)
# DASHBOARD_COOKIE_SECURE=1
